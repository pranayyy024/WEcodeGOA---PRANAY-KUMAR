# Monorepo-wide Git ignore rules
# Keep source files, Dockerfiles, README files, and example config files tracked.

# ----------------------------------------------------------------------------
# Dependency folders (nested anywhere in the monorepo)
# ----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp/
.pnp.js
.pnpm-store/
**/.pnpm-store/
.vite/
**/.vite/

# ----------------------------------------------------------------------------
# Package manager lockfiles
# ----------------------------------------------------------------------------
package-lock.json
**/package-lock.json
pnpm-lock.yaml
**/pnpm-lock.yaml
yarn.lock
**/yarn.lock
bun.lockb
**/bun.lockb

# ----------------------------------------------------------------------------
# Build and generated output folders
# ----------------------------------------------------------------------------
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.turbo/
**/.turbo/
.cache/
**/.cache/
.parcel-cache/
**/.parcel-cache/
.nuxt/
**/.nuxt/
.output/
**/.output/
.svelte-kit/
**/.svelte-kit/
.storybook-static/
**/.storybook-static/
.angular/
**/.angular/
.expo/
**/.expo/
.dart_tool/
**/.dart_tool/

# ----------------------------------------------------------------------------
# Python artifacts and virtual environments
# ----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.tox/
**/.tox/
nox/
**/nox/
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/
env.bak/
**/env.bak/
venv.bak/
**/venv.bak/
*.egg-info/
**/*.egg-info/
.eggs/
**/.eggs/
pip-wheel-metadata/
**/pip-wheel-metadata/
htmlcov/
**/htmlcov/
.coverage
**/.coverage
.coverage.*
**/.coverage.*
coverage.xml
**/coverage.xml
*.cover
**/*.cover

# ----------------------------------------------------------------------------
# Java / JVM / compiled binaries
# ----------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.exe
*.dll
*.so
*.dylib
*.o
*.a
*.whl
*.pdb
*.test

# ----------------------------------------------------------------------------
# Go / Rust / other toolchain caches
# ----------------------------------------------------------------------------
/bin/
**/bin/
/obj/
**/obj/
Cargo.lock
**/Cargo.lock

# ----------------------------------------------------------------------------
# Terraform / infrastructure artifacts
# ----------------------------------------------------------------------------
.terraform/
**/.terraform/
*.tfstate
**/*.tfstate
*.tfstate.*
**/*.tfstate.*
crash.log
**/crash.log
override.tf
**/override.tf
override.tf.json
**/override.tf.json
*_override.tf
**/*_override.tf
*_override.tf.json
**/*_override.tf.json

# ----------------------------------------------------------------------------
# Logs, temp files, editor swap files, and OS noise
# ----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.pid
*.seed
*.orig
*.swp
*.swo
*~
*.bak
*.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
.vscode/
**/.vscode/
.idea/
**/.idea/
*.iml
**/*.iml
*.code-workspace
**/*.code-workspace

# ----------------------------------------------------------------------------
# Environment files
# Keep example env files tracked.
# ----------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.sample
!**/.env.sample

# ----------------------------------------------------------------------------
# TypeScript / Next.js generated files
# ----------------------------------------------------------------------------
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# ----------------------------------------------------------------------------
# Generated code folders/files
# ----------------------------------------------------------------------------
generated/
**/generated/
gen/
**/gen/
*.generated.*
**/*.generated.*
*.pb.*
**/*.pb.*
