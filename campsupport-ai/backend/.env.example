# ==========================================
# CampSupport AI - Backend Environment Config
# ==========================================

# Application Settings
APP_NAME="CampSupport AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# AI / LLM Provider & Keys ("openai", "gemini", or "mock" for local offline testing)
LLM_PROVIDER="mock"
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

GEMINI_API_KEY="your-gemini-api-key-here"

# Database Connection (PostgreSQL / SQLite fallback for quick hackathon dev)
DATABASE_URL="sqlite:///./campsupport.db"

# Ticketing Service ("mock", "zendesk", "servicenow")
TICKETING_PROVIDER="mock"
ZENDESK_SUBDOMAIN="campus-support"
ZENDESK_EMAIL="helpdesk@campus.edu"
ZENDESK_API_TOKEN="zendesk_sample_token"

# LlamaIndex / RAG Settings
RAG_CONFIDENCE_THRESHOLD=0.75
APPROVED_DOCS_PATH="./data/approved_docs"
