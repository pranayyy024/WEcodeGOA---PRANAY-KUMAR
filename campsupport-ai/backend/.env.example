# ==========================================
# CampSupport AI - Environment Configuration
# ==========================================

# --- Application Settings ---
APP_NAME="CampSupport AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# --- AI / LLM Provider Configuration ---
# Options: "mock" (default offline mode without keys), "openai", or "gemini"
LLM_PROVIDER="mock"

# Paste your OpenAI API Key here and set LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Optional: Gemini API Key (not required if using OpenAI or mock mode)
GEMINI_API_KEY=""

# --- LlamaIndex Knowledge Base ---
APPROVED_DOCS_PATH="./data/approved_docs"
RAG_CONFIDENCE_THRESHOLD=0.65

# --- MongoDB / Database Settings ---
# Local Docker or MongoDB Atlas Cloud URI
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="campsupport"

# --- Support Ticketing System ---
# Options: "mock" (default in-memory service), "zendesk", or "servicenow"
TICKETING_PROVIDER="mock"
